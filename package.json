{
  "name": "tailswatch",
  "version": "1.7.0",
  "description": "Customizable Tailwind CSS 4+ themes for import into other applications. Bootswatch-inspired themes, Material Design themes, programming language-inspired themes, Node.js framework themes, HTTP framework themes, web framework themes, cloud provider themes, NFL team themes, NBA team themes, NHL team themes, motorsports themes, and Vocaloid-inspired themes.",
  "author": "Joseph Quinn",
  "license": "MIT",
  "type": "module",
  "main": "dist/themes/default.css",
  "style": "dist/themes/default.css",
  "exports": {
    ".": {
      "style": "./dist/themes/default.css",
      "default": "./dist/themes/default.css"
    },
    "./themes/*": {
      "style": "./dist/themes/*.css",
      "default": "./dist/themes/*.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "pnpm run clean && pnpm run build:themes",
    "build:themes": "node scripts/build-themes.js",
    "clean": "rm -rf dist build",
    "test": "node --test scripts/",
    "prepublishOnly": "pnpm run build"
  },
  "peerDependencies": {
    "tailwindcss": "^4.0.0"
  },
